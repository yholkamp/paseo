# Artifact Registry Maven repository to proxy, with a trailing slash:
# https://<LOCATION>-maven.pkg.dev/<PROJECT>/<REPOSITORY>/
GAR_UPSTREAM=

# Docker network the Paseo container is on.
PASEO_NETWORK=

# Optional: service account to impersonate when minting tokens. Leave empty to
# use the active gcloud account.
GAR_SERVICE_ACCOUNT=

# Optional: where the token file is written. Defaults to ~/.local/state/gar-proxy.
# GAR_AUTH_DIR=
